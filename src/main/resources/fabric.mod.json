{
  "schemaVersion": 1,
  "id": "fabric-api-base",
  "name": "Fabric API Base",
  "provides": ["meteor-client"],
  "version": "${version}",
  "description": "Contains the essentials for Fabric API modules.",
  "authors": [
    "FabricMC"
  ],
  "contact": {
    "homepage": "https://fabricmc.net",
    "irc": "irc://irc.esper.net:6667/fabric",
    "issues": "https://github.com/FabricMC/fabric/issues",
    "sources": "https://github.com/FabricMC/fabric"
  },
  "license": "GPL-3.0",
  "icon": "assets/fabric-api-base/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["meteordevelopment.meteorclient.MeteorClient"],
    "libjf:asm": ["meteordevelopment.meteorclient.asm.Asm"],
    "modmenu": ["meteordevelopment.meteorclient.modintegration.ModMenuIntegration"]
  },
  "mixins": [
    "meteor-client.mixins.json",
    "meteor-client-baritone.mixins.json",
    "meteor-client-indigo.mixins.json",
    "meteor-client-sodium.mixins.json",
    "meteor-client-lithium.mixins.json",
    "meteor-client-viafabricplus.mixins.json"
  ],
  "accessWidener": "meteor-client.classtweaker",
  "custom": {
    "fabric-api:module-lifecycle": "stable",
    "badoptimizations:cache_hooks": {
      "lightmap": "meteordevelopment.meteorclient.modintegration.BadOptimizationsHook"
    }
  },
  "depends": {
    "java": ">=${jdk_version}",
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${loader_version}"
  },
  "breaks": {
    "optifabric": "*",
    "feather": "*",
    "sodium": "<0.9.1",
    "morechathistory": "*",
    "lithium": "<0.22.1",
    "quilt_loader": "*"
  }
}
